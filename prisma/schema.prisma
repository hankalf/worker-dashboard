// Prisma schema for the warehouse dashboard
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  DONE
}

// Work shifts: FIRST 6am-2pm, SECOND 2pm-10pm, THIRD 10pm-6am.
enum Shift {
  FIRST
  SECOND
  THIRD
}

// Daily attendance state for an employee.
enum Attendance {
  PRESENT
  ABSENT
  CALLED_OUT
  PTO
}

// Admin-panel access. NONE = no login; LEAD = dashboard, notices, assign,
// lunches, side tasks; SUPERVISOR = those + attendance; ADMIN = full control.
enum AccessLevel {
  NONE
  LEAD
  SUPERVISOR
  ADMIN
}

// A warehouse / site. Every operational record belongs to exactly one Location,
// so one deployment can run several independent warehouses from a single admin
// login (each with its own employees, positions, notices, attendance, etc.).
// The active location is resolved per-request (see src/lib/location.ts) and all
// tenant-scoped queries are filtered to it automatically by the Prisma
// extension in src/lib/prisma.ts.
model Location {
  id        String   @id @default(cuid())
  name      String
  // URL-safe identifier used on the public board (e.g. /?loc=shipping-dock) and
  // by fleet screens. Unique across the whole deployment.
  slug      String   @unique
  createdAt DateTime @default(now())

  employees            Employee[]
  positions            Position[]
  roles                Role[]
  capabilities         Capability[]
  announcements        Announcement[]
  noticeLogs           NoticeLog[]
  shiftNotes           ShiftNote[]
  headcountSnapshots   HeadcountSnapshot[]
  workHistory          WorkHistory[]
  lunchHistory         LunchHistory[]
  laborShares          LaborShare[]
  scheduledAssignments ScheduledAssignment[]
  jobs                 Job[]
  taskLogs             TaskLog[]
  activityLogs         ActivityLog[]
  screens              Screen[]
}

// A physical wall display registered to a location. Each screen has an
// unguessable token; pointing a monitor at /screen/<token> renders that
// location's board (read-only), so one deployment can drive many screens across
// several warehouses. lastSeenAt powers the Fleet tab's online/offline status.
model Screen {
  id         String    @id @default(cuid())
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String
  name       String
  token      String    @unique
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
}

// Every person in the warehouse. Employees with admin access get a
// username + password and can sign in to the admin panel.
model Employee {
  id           String      @id @default(cuid())
  location     Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId   String    @default("")
  name         String
  accessLevel  AccessLevel @default(NONE)
  // A super-admin (only meaningful for ADMIN) manages every location: they can
  // switch the active location, create/rename/delete locations, and oversee the
  // fleet. Regular admins are confined to their own location.
  isSuperAdmin Boolean     @default(false)
  username     String?     @unique
  passwordHash String?
  position     Position? @relation(fields: [positionId], references: [id])
  positionId   String?
  roles        Role[]    @relation("EmployeeRoles")
  capabilities Capability[] @relation("EmployeeCapabilities")
  jobs         Job[]
  scheduledAssignments ScheduledAssignment[]
  // Lunch window as "HH:MM" strings (24h); end defaults to start+30min if unset
  lunchStart   String?
  lunchEnd     String?
  // Optional short (15-min) break start, "HH:MM"
  breakStart   String?
  // If set (and in the future), the employee is staying past their shift end to
  // help the next shift — keeps showing on the main dashboard until this time.
  stayOverUntil DateTime?
  // If set (and in the future), the employee is covering the CURRENT shift
  // (e.g. came in early from another shift) — shows on the board until this time
  // (their own shift's next start, computed when marked).
  coverUntil    DateTime?
  // The time they're coming in (drives the "In at …" badge).
  comingInAt    DateTime?
  shift        Shift?
  attendance   Attendance @default(PRESENT)
  isLead       Boolean    @default(false)
  // Calendar dates as "YYYY-MM-DD" (date-only, so no timezone drift) — drive
  // the work-anniversary and birthday badges.
  hireDate     String?
  birthDate    String?
  terminatedAt DateTime?
  createdAt    DateTime  @default(now())
}

// Physical equipment / certifications an employee can operate. NOTE: the model
// is named Role for historical reasons but the entire UI calls it "Equipment".
model Role {
  id                   String     @id @default(cuid())
  location             Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId           String    @default("")
  name                 String
  description          String?
  employees            Employee[] @relation("EmployeeRoles")
  requiredForPositions Position[] @relation("PositionRequiredRole")

  @@unique([locationId, name])
}

// A job function an employee can perform (e.g. Receive, Ship, Pick, Putaway,
// DAX). Shown as "Roles" in the UI. Distinct from Equipment; an employee can
// have several.
model Capability {
  id          String     @id @default(cuid())
  location    Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId  String    @default("")
  name        String
  description String?
  // Display order on employee cards (and the Roles setup list).
  sortOrder   Int        @default(0)
  employees   Employee[] @relation("EmployeeCapabilities")
  requiredForPositions Position[] @relation("PositionRequiredCapability")

  @@unique([locationId, name])
}

model Position {
  id             String     @id @default(cuid())
  location       Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId     String    @default("")
  title          String
  description    String?
  sortOrder      Int        @default(0)
  // Target minimum present headcount per shift (0 = no target). Drives the
  // "understaffed" flags on the board.
  minFirst       Int        @default(0)
  minSecond      Int        @default(0)
  minThird       Int        @default(0)
  employees      Employee[]
  scheduledAssignments ScheduledAssignment[]
  laborShares    LaborShare[]
  // Optional equipment a person should hold to work this position (assign warning).
  requiredRole   Role?      @relation("PositionRequiredRole", fields: [requiredRoleId], references: [id])
  requiredRoleId String?
  // Optional role (job function) a person should be able to perform here.
  requiredCapability   Capability? @relation("PositionRequiredCapability", fields: [requiredCapabilityId], references: [id])
  requiredCapabilityId String?

  @@unique([locationId, title])
}

// Notices shown on the dashboards. The board shows up to 5 active notices at a
// time (oldest first); any beyond that queue until an active one expires.
// Pinned notices always show (above the cap) and never queue out.
model Announcement {
  id        String    @id @default(cuid())
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String    @default("")
  message   String
  // Optional scheduled start: hidden from the board until this time. Regular
  // notices allow up to 48h ahead; events (isEvent) allow far-future dates.
  // Null = show immediately.
  startsAt  DateTime?
  expiresAt DateTime?
  pinned    Boolean   @default(false)
  // Preplanned event scheduled months ahead; managed in its own admin section.
  isEvent   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Append-only log of every notice posted (kept even after the notice is
// deleted/expires), with who posted it — powers the Notices-tab history and
// one-click repost.
model NoticeLog {
  id        String   @id @default(cuid())
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String    @default("")
  message   String
  postedBy  String?
  createdAt DateTime @default(now())

  @@index([locationId, createdAt])
}

// One handoff note per shift per location (shift is the key: FIRST | SECOND |
// THIRD), shown above the notices for the currently-active shift and carried
// until the next crew edits it.
model ShiftNote {
  location      Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId    String    @default("")
  shift         String
  message       String
  updatedByName String?
  updatedAt     DateTime @updatedAt

  @@id([locationId, shift])
}

// Daily per-shift headcount snapshot for attendance history. One row per
// (date, shift); date is the Eastern calendar day as "YYYY-MM-DD".
model HeadcountSnapshot {
  id         String   @id @default(cuid())
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String    @default("")
  date       String
  shift      String
  present    Int
  total      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([locationId, date, shift])
  @@index([locationId, date])
}

// Which position each employee worked on which day (Eastern date). Name/title
// are snapshotted so history survives renames. Included in the log export and
// auto-purged after ~2 weeks; the Employee/Position records themselves are kept.
model WorkHistory {
  id            String   @id @default(cuid())
  location      Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId    String    @default("")
  date          String
  employeeId    String
  employeeName  String
  positionId    String
  positionTitle String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([date, employeeId, positionId])
  @@index([locationId, createdAt])
}

// Each employee's scheduled lunch time on a given Eastern day. Name is
// snapshotted so history survives renames. Kept for a 2-week window like the
// attendance history; drives the Lunches admin tab.
model LunchHistory {
  id           String   @id @default(cuid())
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId   String    @default("")
  date         String
  employeeId   String
  employeeName String
  lunchStart   String
  shift        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([date, employeeId])
  @@index([createdAt])
  @@index([locationId, date])
}

// Simple key/value store for editable site settings (e.g. the dashboard name
// shown across the public board, login page, and admin panel).
model Setting {
  key   String @id
  value String
}

// Temporary "labor share" workers borrowed for a single shift. They are NOT
// real Employees and never appear in the Employees list. They show on the
// board for their allotted shift and are auto-purged once endsAt has passed
// (endsAt = the leaving time, or the shift's end if none was given).
model LaborShare {
  id         String    @id @default(cuid())
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String    @default("")
  name       String
  shift      Shift
  position   Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  positionId String?
  comingInAt DateTime?
  leavingAt  DateTime?
  endsAt     DateTime
  date       String
  createdAt  DateTime  @default(now())

  @@index([endsAt])
}

// A planned position assignment for an employee on a specific upcoming date
// (Eastern "YYYY-MM-DD"). Admins set these on the assign board up to ~7 days
// ahead (weekdays). When the date arrives, applyDueSchedules() copies each onto
// the live board (Employee.positionId) once; past-date rows are then purged.
model ScheduledAssignment {
  id         String    @id @default(cuid())
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String    @default("")
  date       String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  position   Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  positionId String?
  updatedAt  DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([locationId, date])
}

model Job {
  id                 String    @id @default(cuid())
  location           Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId         String    @default("")
  title              String
  description        String?
  status             JobStatus @default(UNASSIGNED)
  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id])
  assignedEmployeeId String?
  dueDate            DateTime?
  priority           Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Append-only history of side-task activity (created / updated / deleted).
// Keeps a title snapshot so entries survive the task being deleted.
model TaskLog {
  id         String   @id @default(cuid())
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String    @default("")
  jobId      String?
  jobTitle   String
  action     String
  // Who performed the action (snapshotted display name), best-effort.
  actorName  String?
  createdAt  DateTime @default(now())

  @@index([locationId, createdAt])
}

// Site-wide activity log (assignments, shifts, lunches, roles, tasks, etc.).
// Retained ~2 weeks then purged when the Activity tab is loaded.
model ActivityLog {
  id         String   @id @default(cuid())
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String    @default("")
  category   String
  action     String
  subjectId  String?
  actorId    String?
  actorName  String?
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([locationId, createdAt])
  @@index([subjectId])
}
