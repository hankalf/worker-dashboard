// Prisma schema for the warehouse dashboard
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  DONE
}

// Work shifts: FIRST 6am-2pm, SECOND 2pm-10pm, THIRD 10pm-6am.
enum Shift {
  FIRST
  SECOND
  THIRD
}

// Daily attendance state for an employee.
enum Attendance {
  PRESENT
  ABSENT
  CALLED_OUT
}

// Admin-panel access. NONE = no login; SUPERVISOR = limited (assign, attendance,
// lunch, shift, side tasks, announcements); ADMIN = full control.
enum AccessLevel {
  NONE
  SUPERVISOR
  ADMIN
}

// Every person in the warehouse. Employees with admin access get a
// username + password and can sign in to the admin panel.
model Employee {
  id           String      @id @default(cuid())
  name         String
  accessLevel  AccessLevel @default(NONE)
  username     String?     @unique
  passwordHash String?
  position     Position? @relation(fields: [positionId], references: [id])
  positionId   String?
  roles        Role[]    @relation("EmployeeRoles")
  jobs         Job[]
  // Lunch window as "HH:MM" strings (24h); end defaults to start+30min if unset
  lunchStart   String?
  lunchEnd     String?
  shift        Shift?
  attendance   Attendance @default(PRESENT)
  createdAt    DateTime  @default(now())
}

// A capability an employee has — the kinds of job they can perform.
model Role {
  id                   String     @id @default(cuid())
  name                 String     @unique
  description          String?
  employees            Employee[] @relation("EmployeeRoles")
  requiredForPositions Position[] @relation("PositionRequiredRole")
}

model Position {
  id             String     @id @default(cuid())
  title          String     @unique
  description    String?
  employees      Employee[]
  // Optional role a person should hold to work this position (assign warning).
  requiredRole   Role?      @relation("PositionRequiredRole", fields: [requiredRoleId], references: [id])
  requiredRoleId String?
}

// Single pinned message shown on the dashboards (id is always "current").
model Announcement {
  id        String   @id
  message   String
  updatedAt DateTime @updatedAt
}

model Job {
  id                 String    @id @default(cuid())
  title              String
  description        String?
  status             JobStatus @default(UNASSIGNED)
  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id])
  assignedEmployeeId String?
  dueDate            DateTime?
  priority           Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Append-only history of side-task activity (created / updated / deleted).
// Keeps a title snapshot so entries survive the task being deleted.
model TaskLog {
  id        String   @id @default(cuid())
  jobId     String?
  jobTitle  String
  action    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Site-wide activity log (assignments, shifts, lunches, roles, tasks, etc.).
// Retained ~2 weeks then purged when the Activity tab is loaded.
model ActivityLog {
  id        String   @id @default(cuid())
  category  String
  action    String
  subjectId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([subjectId])
}
