# Copy this file to `.env` (same directory as docker-compose.yml) and fill in.
# docker compose reads `.env` automatically.

# REQUIRED: session-signing secret. Generate one with:  npx auth secret
# (or: openssl rand -base64 32)
NEXTAUTH_SECRET=

# First admin login, created/reset on every startup (idempotent).
# Change the password after your first sign-in.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# Password for the built-in "superadmin" SuperUser (all-locations, protected).
SUPERADMIN_PASSWORD=superadmin

# Postgres credentials for the bundled `db` service. Defaults are fine for a
# LAN box, but set a real password if the machine is reachable by others.
POSTGRES_USER=worker
POSTGRES_PASSWORD=worker
POSTGRES_DB=worker

# Host port the dashboard is served on (http://<box-ip>:<APP_PORT>).
APP_PORT=3000

# Only for docker-compose.prebuilt.yml: which published image to run. Defaults
# to the latest CI build; pin a specific one like
# ghcr.io/hankalf/worker-dashboard:master-<sha> if you want.
# IMAGE=ghcr.io/hankalf/worker-dashboard:latest
